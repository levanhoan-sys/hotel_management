# Chỉ cần dùng tài khoản MySQL đã có trên máy.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/hotel_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Cấu hình backend; có thể để mặc định khi chạy trên máy cá nhân.
SERVER_PORT=8080
ACCESS_TOKEN_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Điền đủ ba mục khi dùng VietQR nhận tiền cọc.
HOTEL_BANK_BIN=
HOTEL_BANK_ACCOUNT=
HOTEL_BANK_ACCOUNT_NAME=
