{
  "name": "hotel-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx backend/index.ts",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint && tsc --noEmit -p backend/tsconfig.json",
    "test": "npm --prefix frontend test",
    "start": "NODE_ENV=production tsx backend/index.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
